# fonts
font-size = 14
font-family = "MonoLisa"

# MonoLisa is a variable font (wght axis 100-1000, defaults to 400).
# Drive the axis directly instead of font-style: face-name matching is
# unreliable here because the regular instance is named "MonoLisa", not "Regular".
font-variation = wght=450
font-variation-italic = wght=450
font-variation-bold = wght=600
font-variation-bold-italic = wght=600

# macOS stem darkening -- off, it bulks glyphs up too much at this weight
font-thicken = false

bold-is-bright = true
theme = kanagawabones

# cursor
cursor-style = block
cursor-style-blink = false

# clipboard
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

# mouse
mouse-scroll-multiplier = 2
mouse-hide-while-typing = true

# window
initial-window = true
resize-overlay = never
window-save-state = always
window-step-resize = false
background-opacity = 1
background-blur-radius = 15
window-padding-balance = true
confirm-close-surface = false

# behavior
auto-update = check
auto-update-channel = stable
quit-after-last-window-closed = true
shell-integration-features = no-cursor

# macos
macos-option-as-alt = true
macos-titlebar-style = transparent
